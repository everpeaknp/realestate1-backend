SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,realestate1-backend,bijenkhadka.com.au,www.bijenkhadka.com.au

# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=realtor_pal
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://bijenkhadka.com.au,https://www.bijenkhadka.com.au
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://bijenkhadka.com.au,https://www.bijenkhadka.com.au

# Email (for production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Eagle API (credentials are used by Next.js frontend, not Django directly)
# Django chatbot accesses Eagle API via Next.js proxy
FRONTEND_URL=http://localhost:3000
EAGLE_CLIENT_ID=your-eagle-client-id
EAGLE_CLIENT_SECRET=your-eagle-client-secret
EAGLE_TOKEN_URL=https://www.eagleagent.com.au/api/v3/token
EAGLE_GRAPHQL_URL=https://www.eagleagent.com.au/api/v3/graphql

# Property feed source for frontend/backend integration:
# EAGLE_API (existing GraphQL) or REAXML (XML feed imported into Django DB)
PROPERTY_FEED_SOURCE=EAGLE_API

# REAXML FTP import settings (used by: python manage.py import_reaxml_feed --from-ftp)
REAXML_FTP_HOST=ftp.bijenkhadka.com.au
REAXML_FTP_PORT=21
REAXML_FTP_USERNAME=eagle_feed
REAXML_FTP_PASSWORD=your-ftp-password
REAXML_FTP_PATH=incoming/reaxml

REAXML_FTP_PASSIVE=True

# Optional local directory import fallback (used by: python manage.py import_reaxml_feed --local-dir /path)
REAXML_LOCAL_DIR=
REAXML_IMPORT_ON_START=false

# Eagle support also provides XML credentials for feed access/reference
REAXML_XML_USERNAME=your-xml-username
REAXML_XML_PASSWORD=your-xml-password
